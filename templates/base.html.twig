<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{% block title %}Repositories{% endblock %} · {{ satis.name }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#4f5b93">
    <link rel="stylesheet" href="{{ asset('css/satisfy.css') }}">
    <link rel="icon" href="{{ asset('favicon.ico') }}">
    <script src="{{ asset('js/satisfy.js') }}" defer></script>
  </head>
  <body>
    {% set route = app.request.attributes.get('_route', '') %}
    <header class="bar">
      <div class="bar-inner">
        <a class="bar-name" href="{{ path('repository') }}">
          <span class="bar-product">Satisfy</span>
          <span class="bar-repo">{{ satis.name }}</span>
        </a>
        {% block nav %}
          <nav class="nav" aria-label="Admin">
            {% set sections = {
              'Repositories': {route: 'repository', current: route in ['repository', 'repository_new', 'repository_edit', 'repository_delete']},
              'Build': {route: 'satis_build', current: route starts with 'satis_build'},
              'Configuration': {route: 'configuration', current: route == 'configuration'},
              'Import': {route: 'repository_upload', current: route == 'repository_upload'},
            } %}
            {% for label, section in sections %}
              <a href="{{ path(section.route) }}"{% if section.current %} aria-current="page"{% endif %}>{{ label }}</a>
            {% endfor %}
            {% for label, linkRoute in plugin_admin_links() %}
              <a href="{{ path(linkRoute) }}"{% if route starts with linkRoute %} aria-current="page"{% endif %}>{{ label }}</a>
            {% endfor %}
          </nav>
        {% endblock %}
        <div class="bar-end">
          <a href="{{ path('index') }}">View catalogue</a>
          {% if is_granted('IS_AUTHENTICATED_FULLY') %}<a href="{{ path('_logout_main') }}">Log out</a>{% endif %}
        </div>
      </div>
    </header>

    <main class="page {% block page_class %}{% endblock %}">
      {% set flashes = app.flashes %}
      {% if flashes is not empty %}
        <div class="flashes" role="status">
          {% for label, messages in flashes %}
            {% for message in messages %}
              <div class="flash flash-{{ label }}">
                <p>{{ message }}</p>
                <button type="button" class="flash-dismiss" aria-label="Dismiss" data-dismiss>&times;</button>
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      {% endif %}

      {% block content %}{% endblock %}
    </main>
    {% block javascript %}{% endblock %}
  </body>
</html>
