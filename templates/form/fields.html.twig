{# One row of each configuration collection: a package and its value. #}

{% block PackageConstraintType_row %}
    <div class="pair">
        {{ form_widget(form.package, {attr: {'aria-label': 'Package name', class: 'mono'}}) }}
        {{ form_widget(form.constraint, {attr: {'aria-label': 'Version constraint', class: 'mono'}}) }}
        {{ form_errors(form) }}{{ form_errors(form.package) }}{{ form_errors(form.constraint) }}
    </div>
{% endblock %}

{% block PackageStabilityType_row %}
    <div class="pair">
        {{ form_widget(form.package, {attr: {'aria-label': 'Package name', class: 'mono'}}) }}
        {{ form_widget(form.stability, {attr: {'aria-label': 'Minimum stability'}}) }}
        {{ form_errors(form) }}{{ form_errors(form.package) }}{{ form_errors(form.stability) }}
    </div>
{% endblock %}

{% block AbandonedType_row %}
    <div class="pair">
        {{ form_widget(form.package, {attr: {'aria-label': 'Abandoned package', class: 'mono'}}) }}
        {{ form_widget(form.replacement, {attr: {'aria-label': 'Replacement package or URL', class: 'mono'}}) }}
        {{ form_errors(form) }}{{ form_errors(form.package) }}{{ form_errors(form.replacement) }}
    </div>
{% endblock %}
