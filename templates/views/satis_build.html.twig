{% extends "base.html.twig" %}

{% block title %}Satis build{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <p id="satisStatus">&nbsp;</p>
        {{ form_widget(form.build, {'attr': {'class': 'btn btn-large btn-block btn-primary'}}) }}
    {{ form_end(form) }}
    <pre id="satisOutput"></pre>
{% endblock %}

{% block javascript %}
    <script type="text/javascript">
    $(function(){
        var status = $("#satisStatus");
        var output = $("#satisOutput");
        var refresh = function(){
            $.getJSON("{{ path('satis_build_status') }}", function(data){
                var text = data.building ? 'Building.' : 'No build running.';
                if (data.pending > 0) {
                    text += ' ' + data.pending + ' waiting.';
                }
                status.text(text);
                output.text(data.log);
            });
        };
        refresh();
        setInterval(refresh, 2000);
    });
    </script>
{% endblock %}
