{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}
{% block nav %}{% endblock %}

{% block content %}
<div class="signin">
  <h1>Sign in</h1>
  <p class="lead">To manage the repositories in {{ satis.name }}.</p>
  <form class="form-card" action="{{ path('login') }}" method="post">
    {% if error %}
      <ul class="form-errors form-errors-top"><li>{{ error.messageKey|replace(error.messageData) }}</li></ul>
    {% endif %}
    <div class="field">
      <label for="username">Username</label>
      <input type="text" id="username" name="_username" value="{{ username }}" autocomplete="username" required autofocus>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="_password" autocomplete="current-password" required>
    </div>
    <div class="actions">
      <button class="btn btn-primary" type="submit">Sign in</button>
    </div>
  </form>
</div>
{% endblock %}
