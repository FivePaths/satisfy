# Copy to demo/.env, which Docker Compose reads when it runs in demo/.

# The port Satisfy answers on.
SATISFY_PORT=8000

# Host names besides localhost that MCP requests may be addressed to, comma-
# separated, when the demo runs on another machine than the MCP client.
# SATISFY_MCP_ALLOWED_HOSTS=demo.example.com

# The model that diagnoses a failed build: any OpenAI-compatible endpoint whose
# models can call tools. Without a URL and a model, nothing is diagnosed.

# Hugging Face's router, with a fine-grained token that may "Make calls to
# Inference Providers". This is the setup the plugin was tested with.
SATISFY_DIAGNOSIS_URL=https://router.huggingface.co
SATISFY_DIAGNOSIS_MODEL=openai/gpt-oss-120b
SATISFY_DIAGNOSIS_API_KEY=

# Or an Ollama on the host, with a model that supports tools; no key. Not tried.
# SATISFY_DIAGNOSIS_URL=http://host.docker.internal:11434
# SATISFY_DIAGNOSIS_MODEL=qwen3

# Or OpenRouter.
# SATISFY_DIAGNOSIS_URL=https://openrouter.ai/api
# SATISFY_DIAGNOSIS_MODEL=openai/gpt-oss-120b
