{% extends "base.html.twig" %}

{% block title %}Package access{% endblock %}

{% block content %}
    <h2>Package access</h2>

    {% if requests is not empty %}
        <div class="panel panel-warning">
            <div class="panel-heading">
                {{ requests|length }} site{{ requests|length == 1 ? '' : 's' }} asking for packages
            </div>
            <ul class="list-group">
                {% for name, rows in requests %}
                    <li class="list-group-item">
                        <span class="pull-right">
                            {% include '@Authz/_action.html.twig' with {action: 'approve_all', site: name, back: 'index', label: 'Approve all ' ~ rows|length, class: 'btn-primary'} %}
                        </span>
                        <a href="{{ path('authz_site', {site: name}) }}"><code>{{ name }}</code></a>
                        wants
                        {% for row in rows %}<span class="label label-default">{{ row.package }}</span> {% endfor %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <table class="table table-condensed table-striped">
        <thead>
            <tr><th>Site</th><th>State</th><th>Packages</th><th>Grants</th><th>Asking</th><th>Last seen</th><th>Note</th></tr>
        </thead>
        <tbody>
            {% for name, s in sites %}
                <tr>
                    <td><a href="{{ path('authz_site', {site: name}) }}"><code>{{ name }}</code></a></td>
                    <td>{{ s.active ? 'active' : 'revoked' }}</td>
                    <td>{{ s.package_enforce ? 'enforcing' : 'observing' }}</td>
                    <td>{{ s.grants }}</td>
                    <td>{{ s.pending ?: '' }}</td>
                    <td>{{ observed[name] is defined ? observed[name].last|date('Y-m-d H:i') : 'never' }}</td>
                    <td>{{ s.note }}</td>
                </tr>
            {% else %}
                <tr><td colspan="7">No sites yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    <h3>Issue a token</h3>
    <form method="post" action="{{ path('authz_action') }}" class="form-inline">
        <input type="hidden" name="_token" value="{{ csrf_token(csrf) }}">
        <input type="hidden" name="action" value="issue">
        <input class="form-control" name="site" placeholder="site name" required pattern="[A-Za-z0-9._\-]{1,64}">
        <input class="form-control" name="note" placeholder="what it is" size="40">
        <button class="btn btn-primary">Issue</button>
    </form>

    <h3>Credential enforcement</h3>
    <p>
        Currently <strong>{{ enforcing ? 'on' : 'off: requests are recorded and allowed' }}</strong>.
        Requests seen without a valid token: <strong>{{ unauth }}</strong>, canary probes excluded.
        Per-site package rules apply only while this is on.
    </p>
    {% include '@Authz/_action.html.twig' with {action: 'enforce', value: enforcing ? 'off' : 'on', label: enforcing ? 'Switch to permissive' : 'Enable enforcement', class: enforcing ? 'btn-default' : 'btn-danger'} %}
{% endblock %}
