{% extends "base.html.twig" %}

{% block title %}{{ site }}{% endblock %}
{% block page_class %}page-narrow{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <p class="crumbs"><a href="{{ path('authz') }}">Package access</a> /</p>
            <h1><span class="mono">{{ site }}</span></h1>
            <p class="lead">
                <span class="badge {{ row.active ? 'badge-ok' : 'badge-bad' }}">{{ row.active ? 'active' : 'revoked' }}</span>
                <span class="badge {{ row.package_enforce ? 'badge-php' : '' }}">packages: {{ row.package_enforce ? 'enforcing' : 'observing' }}</span>
                {{ seen is null ? 'Never authenticated.' : 'Last seen ' ~ seen.last|date('Y-m-d H:i') ~ '.' }}
            </p>
        </div>
    </div>

    {% if issued %}
        <section class="secret" aria-labelledby="secret-title">
            <h2 id="secret-title">{{ issued.rotated ? 'Token replaced' : 'Token issued' }}: shown once, only its hash is kept</h2>
            <p>Copy it now. {% if issued.rotated %}The previous token stopped working at once.{% endif %}</p>
            <p class="secret-label">Token</p>
            <pre>{{ issued.token }}</pre>
            <p class="secret-label">COMPOSER_AUTH, which is also the whole of an <span class="mono">auth.json</span></p>
            <pre>{{ composer_auth }}</pre>
        </section>
    {% endif %}

    {% if requests is not empty %}
        <section class="section" aria-labelledby="asking-title">
            <h2 id="asking-title">Asking for <span class="count">{{ requests|length }}</span></h2>
            <div class="table-wrap">
                <table class="table">
                    <tbody>
                        {% for request in requests %}
                            <tr>
                                <td class="url">{{ request.package }}</td>
                                <td class="col-meta col-hide-sm">since {{ request.first_seen|date('Y-m-d H:i') }}</td>
                                <td class="col-end">
                                    {% include '@Authz/_action.html.twig' with {action: 'approve', site: site, package: request.package, label: 'Approve', class: 'btn-primary'} %}
                                    {% include '@Authz/_action.html.twig' with {action: 'dismiss', site: site, package: request.package, label: 'Dismiss'} %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <div class="table-foot">{% include '@Authz/_action.html.twig' with {action: 'approve_all', site: site, label: 'Approve all ' ~ requests|length, class: 'btn-primary'} %}</div>
            </div>
        </section>
    {% endif %}

    <section class="section" aria-labelledby="granted-title">
        <h2 id="granted-title">Granted</h2>
        <p class="section-lead">{{ reach }} package{{ reach == 1 ? '' : 's' }} reachable, dependencies included.</p>
        <div class="table-wrap">
            <table class="table">
                <tbody>
                    {% for package in direct %}
                        <tr>
                            <td class="url">{{ package }}</td>
                            <td class="col-end">{% include '@Authz/_action.html.twig' with {action: 'ungrant', site: site, package: package, label: 'Remove'} %}</td>
                        </tr>
                    {% else %}
                        <tr class="table-empty"><td>Nothing granted: every package request is refused once package enforcement is on.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if implied is not empty %}
            <p class="section-lead">Through dependencies:</p>
            <div class="chips">{% for package in implied %}<span class="chip">{{ package }}</span>{% endfor %}</div>
        {% endif %}
        <form method="post" action="{{ path('authz_action') }}" class="row-form">
            <input type="hidden" name="_token" value="{{ csrf_token(csrf) }}">
            <input type="hidden" name="action" value="grant">
            <input type="hidden" name="site" value="{{ site }}">
            <div class="field">
                <label for="grant-package">Grant a package</label>
                <input type="text" id="grant-package" class="mono" name="package" list="authz-hosted" placeholder="vendor/package or vendor/*" required autocomplete="off">
                <datalist id="authz-hosted">{% for package in hosted %}<option value="{{ package }}">{% endfor %}</datalist>
            </div>
            <button class="btn">Grant</button>
        </form>
    </section>

    <section class="section" aria-labelledby="note-title">
        <h2 id="note-title">Note</h2>
        <form method="post" action="{{ path('authz_action') }}" class="row-form">
            <input type="hidden" name="_token" value="{{ csrf_token(csrf) }}">
            <input type="hidden" name="action" value="note">
            <input type="hidden" name="site" value="{{ site }}">
            <div class="field">
                <label class="visually-hidden" for="site-note">Note</label>
                <input type="text" id="site-note" name="note" value="{{ row.note }}" placeholder="What this site is">
            </div>
            <button class="btn">Save note</button>
        </form>
    </section>

    <section class="section" aria-labelledby="settings-title">
        <h2 id="settings-title">Settings</h2>
        <div class="setting">
            <div>
                <h3>Package enforcement</h3>
                <p>{{ row.package_enforce ? 'On: packages not granted are refused and recorded for approval.' : 'Off: packages not granted are allowed and recorded for approval.' }}</p>
            </div>
            {% include '@Authz/_action.html.twig' with {action: 'pkgmode', site: site, value: row.package_enforce ? 'off' : 'on', label: row.package_enforce ? 'Only record other packages' : 'Refuse other packages'} %}
        </div>
        <div class="setting">
            <div>
                <h3>Token</h3>
                <p>Replacing it shows a new token once; the current one stops working at once.</p>
            </div>
            {% include '@Authz/_action.html.twig' with {action: 'issue', site: site, label: 'Replace the token', class: 'btn-danger'} %}
        </div>
        <div class="setting">
            <div>
                <h3>{{ row.active ? 'Revoke access' : 'Restore access' }}</h3>
                <p>{{ row.active ? 'The site’s token stops being accepted until access is restored.' : 'Restoring makes the site’s current token valid again.' }}</p>
            </div>
            {% include '@Authz/_action.html.twig' with {action: row.active ? 'revoke' : 'restore', site: site, label: row.active ? 'Revoke' : 'Restore', class: row.active ? 'btn-danger-solid' : ''} %}
        </div>
    </section>
{% endblock %}
