{/member}","avatar_url":"https://avatars.githubusercontent.com/u/86118887?v=4","description":""},"sender":{"login":"tylershuster","id":3999320,"node_id":"MDQ6VXNlcjM5OTkzMjA=","avatar_url":"https://avatars.githubusercontent.com/u/3999320?v=4","gravatar_id":"","url":"https://api.github.com/users/tylershuster","html_url":"https://github.com/tylershuster","followers_url":"https://api.github.com/users/tylershuster/followers","following_url":"https://api.github.com/users/tylershuster/following{/other_user}","gists_url":"https://api.github.com/users/tylershuster/gists{/gist_id}","starred_url":"https://api.github.com/users/tylershuster/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tylershuster/subscriptions","organizations_url":"https://api.github.com/users/tylershuster/orgs","repos_url":"https://api.github.com/users/tylershuster/repos","events_url":"https://api.github.com/users/tylershuster/events{/privacy}","received_events_url":"https://api.github.com/users/tylershuster/received_events","type":"User","user_view_type":"public","site_admin":false},"created":true,"deleted":false,"base_ref":"refs/heads/4.x","compare":"https://github.com/FivePaths/satisfy/compare/webhook-fixture","commits":[],"head_commit":{"id":"42d149814473826fd8087de5c0ad8b770a8654f2","tree_id":"7c6c51bb8dc6ff28477ab3ef1ae44be60b0671c2","distinct":true,"message":"Webhooks: GitHub, Gitea, Bitbucket and Azure DevOps checked against their documented deliveries; upgrade notes finished\n\nGitHub and Gitea no longer stream \"OK\" and build in place: they answer 202 queued through the same path as the others, so plugins see their deliveries. GitHub's ping is answered without a lookup, form-encoded deliveries are accepted, and auto-add takes the HTTPS clone URL rather than git://. Signatures are checked in constant time over the body as sent, which drops swop/github-webhook and the PSR-7 bridge.\n\nBitbucket takes a secret (BITBUCKET_SECRET), checked against X-Hub-Signature; without one, the address list is Atlassian's current one, IPv6 included. Azure DevOps looks up remoteUrl, the clone URL: 3.x read url, which is the REST API URL, so no real delivery could match. getCreatedTag() reads Bitbucket's and Azure DevOps' shapes too.\n\nUPGRADE-4.0.md opens with the steps a 3.x deployment takes, and the README lists each provider's endpoint and secret. The smoke test now posts to the github and bitbucket endpoints in the image, and 136 tests pass in Satisfy's suite. Deliveries from real accounts are still to be replayed, which needs a Gitea account, among others.","timestamp":"2026-10-22T12:07:53-07:00","url":"https://github.com/FivePaths/satisfy/commit/42d149814473826fd8087de5c0ad8b770a8654f2","author":{"name":"Tyler Brown Cifu Shuster","email":"tyler@fivepaths.com","date":"2026-10-22T12:07:53-07:00","username":"tylershuster"},"committer":{"name":"Tyler Brown Cifu Shuster","email":"tyler@fivepaths.com","date":"2026-10-22T12:07:53-07:00","username":"tylershuster"},"added":["tests/Webhook/WebhookProvidersTest.php","tests/fixtures/bitbucket-push.json","tests/fixtures/gitea-push.json","tests/fixtures/github-ping.json","tests/fixtures/github-push-tag.json"],"removed":[],"modified":[".env","README.md","UPGRADE-4.0.md","composer.json","composer.lock","config/services.yaml","docker/smoke-test.sh","docs/4.0-architecture.md","docs/plugins.md","src/Event/WebhookReceivedEvent.php","src/Webhook/AbstractWebhook.php","src/Webhook/BitbucketWebhook.php","src/Webhook/DevOpsWebhook.php","src/Webhook/GiteaWebhook.php","src/Webhook/GithubWebhook.php","tests/Webhook/GithubWebhookTest.php","tests/fixtures/devops-push.json"]}}